# Uploaded files are images only, but block script execution here as defense in depth.
<FilesMatch "\.(php|php\d|phtml|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>

<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
